        <zone flipboard-zone-id='5' forceUpdate='true' h='65041' id='11' story-point-id='8' type-v2='text' w='55693' x='412' y='14834'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontsize='16'>Objective</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Segoe UI'>The objective of this project is to analyze the overall performance of a food delivery system using Tableau. </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Segoe UI'>The dashboard provides an interactive view of delivery operations by monitoring key performance indicators such as total orders, customer ratings, average delivery time, city-wise order distribution, vehicle usage, traffic conditions, festival impact, and delivery categories.</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Segoe UI'>It helps identify operational trends and supports data-driven business decisions. </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontsize='16'>Tools Used</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Segoe UI'>Tableau </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Segoe UI'>CSV Dataset </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='11203' id='12' story-point-id='8' type-v2='text' w='55291' x='533' y='2697'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='20'>🟦 PROJECT OVERVIEW</run>
          </formatted-text>
        </zone>
      </zones>
